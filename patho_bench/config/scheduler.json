{
    "cosine": {
        "type": "cosine",
        "eta_min": 0.0,
        "step_on": "epoch"
    },
    "cosine_warm_restart" : {
        "type" : "cosine_warm_restart",
        "T_0" : 5,
        "T_mult" : 1,
        "eta_min": 0.0,
        "step_on": "epoch"
    },
    "exp" : {
        "type" : "exp",
        "gamma" : 0.95,
        "step_on" : "epoch"
    },
    "step": {
        "type": "step",
        "gamma": 0.1,
        "milestones": [2, 5, 15, 30],
        "step_on": "epoch"
    },
    "plateau": {
        "type": "plateau",
        "mode": "max",
        "factor": 0.1,
        "patience": 0,
        "threshold": 1e-6,
        "min_lr": 1e-8,
        "step_on": "val-loss"
    },
    "gigapath": {
        "type": "gigapath",
        "warmup_epochs": 1,
        "min_lr": 1e-8,
        "step_on": "model_update"
    }
    
}
