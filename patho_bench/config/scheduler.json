{
    "cosine": {
        "type": "cosine",
        "eta_min": 1e-8,
        "step_on": "accumulation-step"
    },
    "step": {
        "type": "step",
        "gamma": 0.1,
        "milestones": [2, 5, 15, 27],
        "step_on": "epoch"
    },
    "plateau": {
        "type": "plateau",
        "mode": "max",
        "factor": 0.1,
        "patience": 0,
        "threshold": 0.0001,
        "step_on": "val"
    },
    "gigapath": {
        "type": "gigapath",
        "warmup_epochs": 1,
        "min_lr": 0.000001,
        "step_on": "accumulation-step"
    }
}
