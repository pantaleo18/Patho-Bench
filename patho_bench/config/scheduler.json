{
    "cosine": {
        "type": "cosine",
        "eta_min": 1e-6,
        "step_on": "model_update"
    },
    "step": {
        "type": "step",
        "gamma": 0.1,
        "milestones": [2, 5, 15, 27],
        "step_on": "epoch"
    },
    "plateau": {
        "type": "plateau",
        "mode": "max",
        "factor": 0.1,
        "patience": 0,
        "threshold": 1e-6,
        "step_on": "val",
        "min_lr": 1e-6
    },
    "gigapath": {
        "type": "gigapath",
        "warmup_epochs": 1,
        "min_lr": 1e-6,
        "step_on": "model_update"
    }
}
